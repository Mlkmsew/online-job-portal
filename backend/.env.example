# ============================================
# EthioJob Portal - Environment Variables
# ============================================
#
# PRODUCTION (Render Web Service):
#   NODE_ENV=production
#   PORT=10000  (Render injects $PORT automatically; keep it unset or use it)
#   CLIENT_URL=https://your-frontend.onrender.com  (your Render Static Site URL)
#   MONGO_URI=mongodb+srv://... (MongoDB Atlas connection string)
#   Make sure Atlas Network Access allows Render's egress IPs or "Allow access from anywhere".

# Server
NODE_ENV=development
PORT=5000

# CLIENT_URL: The URL where the frontend is running
# Used for password reset links, email verification links, and CORS
# 
# For desktop/localhost development:
#   CLIENT_URL=http://localhost:5173
#
# For mobile device access on the same network:
#   Find your machine's local IP (e.g., 192.168.1.100):
#   - Windows: ipconfig | findstr IPv4
#   - Mac/Linux: ifconfig | grep inet
#   Then use: CLIENT_URL=http://192.168.1.100:5173
#
# IMPORTANT: If using localhost, the backend will automatically detect and use
# your machine's local IP for password reset links to enable mobile access.
# In production set CLIENT_URL to your deployed frontend URL (https://...).
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ethiojob

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production
JWT_REFRESH_EXPIRE=30d

# Email
# EMAIL_PROVIDER selects the transport:
#   https -> Brevo REST API over HTTPS port 443 (REQUIRED on Render free tier,
#            which blocks outbound SMTP ports 25/465/587)
#   smtp  -> Nodemailer SMTP (local development fallback)
EMAIL_PROVIDER=smtp

# Brevo (only needed when EMAIL_PROVIDER=https)
# Create the key at app.brevo.com -> SMTP & API -> API Keys. Never commit it.
BREVO_API_KEY=your_brevo_api_key

# SMTP / Nodemailer (used when EMAIL_PROVIDER=smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Common (both providers). The sender address must be a verified sender in Brevo.
# Accepted formats: "Name <you@gmail.com>" or "you@gmail.com"
EMAIL_FROM=OnlineJob Portal <your_email@gmail.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
