# ============================================
# EthioJob Portal - Frontend Environment Variables
# ============================================
#
# These are Vite build-time variables (baked into the bundle at build time).
# NEVER commit real values. Copy this file to .env and fill in your values,
# or set them as environment variables on Render Static Site.

# PRODUCTION (Render Static Site):
#   VITE_API_URL=https://your-backend.onrender.com
#   VITE_SOCKET_URL=https://your-backend.onrender.com
#   VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
#
# Leave VITE_API_URL / VITE_SOCKET_URL empty for local development:
# Vite's dev server proxies /api and /socket.io to the backend on localhost:5000.

# API base URL (falls back to same-origin '/api' when empty)
VITE_API_URL=

# Socket.IO endpoint (falls back to the current origin when empty)
VITE_SOCKET_URL=

# Google OAuth client ID (public, safe to expose)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com